# Names only. Do not commit values.
# Public / non-secret. The Supabase client key is one of the three aliases below.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
CONTACT_EMAIL=
CRM_ADMIN_EMAILS=
WEBAUTHN_ORIGIN=
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=
INBOUND_REPLY_DOMAIN=
# Cloudflare Turnstile for the visitor chat. The site key is public by design, but
# the browser only receives it when the secret and hostnames are also set.
# Comma-separated exact hostnames, e.g. kygrsolutions.com,www.kygrsolutions.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=

# Secret. Cloud agents use a Supabase dev project, never a production service-role key.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
OPENROUTER_API_KEY=
RETELL_API_KEY=
DISCORD_WEBHOOK_URL=
CRON_SECRET=
WEBAUTHN_CHALLENGE_SECRET=
INBOUND_REPLY_SECRET=
TURNSTILE_SECRET_KEY=
# Independent random secret (not a Supabase key) used to HMAC client IPs for chat rate limits.
RATE_LIMIT_SECRET=
